# Generated by ./vps.sh prepare; replace only domains/email before publishing.
CHATWOOT_DOMAIN=chat.example.com
BOT_DOMAIN=bot.example.com
ACME_EMAIL=admin@example.com
FRONTEND_URL=https://chat.example.com
DEFAULT_LOCALE=fa
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
REDIS_PASSWORD=__GENERATE_REDIS_PASSWORD__
REDIS_URL=redis://:__GENERATE_REDIS_PASSWORD__@redis:6379
SECRET_KEY_BASE=__GENERATE_SECRET_KEY_BASE__
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=__GENERATE_ENC_PRIMARY__
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=__GENERATE_ENC_DETERMINISTIC__
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=__GENERATE_ENC_SALT__
