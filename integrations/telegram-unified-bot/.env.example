# Copy to .env and keep outside version control. No real tokens belong in Git.
BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_32_CHARS
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=REPLACE_WITH_ADMIN_USER_ACCESS_TOKEN
CHATWOOT_BASE_URL=http://rails:3000

# Your Telegram numeric user ID(s). ONLY these IDs can access owner controls.
OWNER_TELEGRAM_IDS=123456789
# Telegram numeric ID -> Chatwoot agent user ID. Example: {"987654321":42}
AGENT_MAP_JSON={}
# Each mapped agent must use their OWN Chatwoot user API access token for correct sender attribution/RBAC.
AGENT_API_TOKENS_JSON={}
# Public HTTPS URL routed to this adapter (not the Chatwoot Rails frontend).
PUBLIC_BASE_URL=https://bot.example.com
# Turn on ONLY AFTER creating Chatwoot's Telegram inbox for this BOT_TOKEN.
AUTO_REGISTER_WEBHOOK=false
PORT=8080
